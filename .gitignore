__pycache__/
*.pyc
.ipynb_checkpoints/

# Real ALMA data products (raw MS, CASA image dirs, FITS cubes) are large
# (MBs-GBs) and not meant to be committed -- data/prep_wavelet_data.py
# documents exactly how to regenerate them from the calibrated MS via CASA.
data/*
!data/prep_wavelet_data.py
*.npz
*.npy
*.fits
# macOS
.DS_Store

# CASA writes a timestamped log into the working directory on every run --
# every casatools entry point in this repo redirects it into casa_logs/
casa-*.log
casa_logs/
*.last

# Pipeline outputs (CASA image directories, cached grids, FITS cubes)
results/
results_previous/

# CASA image dirs + .npy cubes written by simple/grid_with_casa.py
simple/data/

# experiment logs
logs/

*.png
*.pdf
*.gif

# CASA scratch lattices (~1 GB each) left behind in the working directory
TempLattice*/

# download logs
*_dl.log
